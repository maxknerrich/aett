{
	"hard_tabs": true,
	"format_on_save": "on",
	"file_scan_exclusions": ["**/.repos", "..."],
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "warn"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": "./vite.config.ts",
					"run": "onSave"
				}
			}
		},
		"vtsls": {
			"settings": {
				"vtsls": {
					"autoUseWorkspaceTsdk": true
				},
				"typescript": {
					"tsdk": "./node_modules/typescript/lib",
					"preferences": {
						"autoImportFileExcludePatterns": [".repos/**"]
					}
				},
				"javascript": {
					"preferences": {
						"autoImportFileExcludePatterns": [".repos/**"]
					}
				}
			}
		}
	},
	"languages": {
		"TypeScript": {
			"language_servers": ["oxlint", "oxfmt", "..."],
			"prettier": { "allowed": false },
			"formatter": [
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"JavaScript": {
			"language_servers": ["oxlint", "oxfmt", "..."],
			"prettier": { "allowed": false },
			"formatter": [
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"JSON": {
			"language_servers": ["oxfmt", "..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"JSONC": {
			"language_servers": ["oxfmt", "..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"YAML": {
			"language_servers": ["oxfmt", "..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		}
	}
}
