{
	"name": "aett",
	"version": "0.1.0",
	"description": "Declare a fleet of NixOS machines, VMs, NASes and Macs in one TypeScript file, and install, apply and back them up over your tailnet.",
	"keywords": [
		"fleet",
		"homelab",
		"nix",
		"nix-darwin",
		"nixos",
		"tailscale"
	],
	"homepage": "https://github.com/maxknerrich/aett",
	"bugs": "https://github.com/maxknerrich/aett/issues",
	"license": "MIT",
	"author": "Max Knerrich",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maxknerrich/aett.git",
		"directory": "packages/aett"
	},
	"bin": {
		"aett": "./dist/cli/main.js"
	},
	"files": [
		"dist",
		"src/engine/nix/flake",
		"plugins"
	],
	"type": "module",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"development": "./src/cli/main.ts",
			"default": "./dist/cli/main.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"jsonc-parser": "catalog:"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24.11.0"
	}
}
